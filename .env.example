# InkSight 环境变量配置
# 复制此文件为 .env.local 并填入实际值

# ===== LLM 服务配置 =====
# 支持任何 OpenAI 兼容接口。下方提供两种方案，任选其一。

# ---------- 方案 A: DeepSeek 官方（默认，按量付费）----------
# 注册: https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-your-deepseek-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---------- 方案 B: OpenCode Zen 免费模型（限时免费，适合跑测试）----------
# 注册: https://opencode.ai/auth  → 登录 → 添加账单信息 → 复制 API 密钥
# 免费模型列表（输入/输出均免费）:
#   deepseek-v4-flash-free   — 与 DeepSeek prompt 完全兼容（推荐跑测试用）
#   big-pickle               — 隐身模型
#   mimo-v2.5-free           — 小米模型
#   north-mini-code-free     — 编码模型
#   nemotron-3-ultra-free    — NVIDIA 模型
# 使用时覆盖上面三行:
# LLM_API_KEY=your-opencode-zen-key
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_MODEL=deepseek-v4-flash-free

# ===== Supabase =====
# 从 Supabase 项目设置 > API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
